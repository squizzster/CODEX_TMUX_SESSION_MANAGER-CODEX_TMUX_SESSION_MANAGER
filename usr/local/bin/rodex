#!/bin/sh
set -eu

# Recommended: install -m 0755 usr/local/bin/rodex "$HOME/.local/bin/rodex"

# This checkout is the default target wherever the shim is copied.
# Override it when the Rodex checkout lives elsewhere.
RODEX_PROJECT_DIR=${RODEX_PROJECT_DIR:-/external_data/data/work_flow_dna/business_genome_classification_system/CODEX_TMUX_SESSION_MANAGER}

if [ ! -f "$RODEX_PROJECT_DIR/pyproject.toml" ]; then
    printf 'rodex: project not found at %s\n' "$RODEX_PROJECT_DIR" >&2
    printf 'rodex: set RODEX_PROJECT_DIR to the Rodex checkout\n' >&2
    exit 1
fi

RODEX_ENTRYPOINT=$RODEX_PROJECT_DIR/.venv/bin/rodex
if [ ! -f "$RODEX_ENTRYPOINT" ] || [ ! -x "$RODEX_ENTRYPOINT" ]; then
    printf 'rodex: project entrypoint is missing or not executable: %s\n' \
        "$RODEX_ENTRYPOINT" >&2
    exit 1
fi

unset PYTHONHOME PYTHONPATH PYTHONSTARTUP
exec "$RODEX_ENTRYPOINT" "$@"
