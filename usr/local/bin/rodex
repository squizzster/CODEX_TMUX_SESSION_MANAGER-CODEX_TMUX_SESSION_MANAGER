#!/bin/sh
set -eu

# Recommended: install -m 0755 usr/local/bin/rodex "$HOME/.local/bin/rodex"

# This checkout is the default target wherever the shim is copied.
# Override it when the Rodex checkout lives elsewhere.
RODEX_PROJECT_DIR=${RODEX_PROJECT_DIR:-/external_data/data/work_flow_dna/business_genome_classfication_system/CODEX_TMUX_SESSION_MANAGER}

if [ ! -f "$RODEX_PROJECT_DIR/pyproject.toml" ]; then
    printf 'rodex: project not found at %s\n' "$RODEX_PROJECT_DIR" >&2
    printf 'rodex: set RODEX_PROJECT_DIR to the Rodex checkout\n' >&2
    exit 1
fi

project_owner_uid=$(/usr/bin/stat -Lc '%u' -- "$RODEX_PROJECT_DIR")
current_uid=$(/usr/bin/id -u)
if [ "$project_owner_uid" != "$current_uid" ] && [ "$project_owner_uid" != 0 ]; then
    printf 'rodex: refusing checkout owned by untrusted uid %s while running as uid %s\n' \
        "$project_owner_uid" "$current_uid" >&2
    exit 1
fi

checkout_issue=$(
    /usr/bin/find "$RODEX_PROJECT_DIR" \
        -path "$RODEX_PROJECT_DIR/.git" -prune -o \
        -path "$RODEX_PROJECT_DIR/.venv/.lock" -prune -o \
        -path "$RODEX_PROJECT_DIR/.pytest_cache/*" -prune -o \
        -path "$RODEX_PROJECT_DIR/.ruff_cache/*" -prune -o \
        \( -type l \( \
            -path "$RODEX_PROJECT_DIR/.venv/bin/python" -o \
            -path "$RODEX_PROJECT_DIR/.venv/bin/python3" -o \
            -path "$RODEX_PROJECT_DIR/.venv/bin/python3.*" -o \
            -path "$RODEX_PROJECT_DIR/.venv/lib64" \
        \) \) -o \
        \( \
            -type l -printf 'symlink:%p\n' -o \
            \( -type f -o -type d \) -perm /022 \
                -printf 'writable:%p\n' -o \
            ! -uid "$current_uid" ! -uid 0 -printf 'owner:%p\n' \
        \) -quit
)
case "$checkout_issue" in
    symlink:*)
        printf 'rodex: refusing project source symlink: %s\n' \
            "${checkout_issue#symlink:}" >&2
        exit 1
        ;;
    writable:*)
        printf 'rodex: refusing group/world-writable project path: %s\n' \
            "${checkout_issue#writable:}" >&2
        exit 1
        ;;
    owner:*)
        printf 'rodex: refusing project path with an untrusted owner: %s\n' \
            "${checkout_issue#owner:}" >&2
        exit 1
        ;;
esac

RODEX_ENTRYPOINT=$RODEX_PROJECT_DIR/.venv/bin/rodex
if [ ! -f "$RODEX_ENTRYPOINT" ] || [ ! -x "$RODEX_ENTRYPOINT" ]; then
    printf 'rodex: sealed project entrypoint is missing or not executable: %s\n' \
        "$RODEX_ENTRYPOINT" >&2
    exit 1
fi

RODEX_INTERPRETER=$(/usr/bin/sed -n '1s/^#!//p' "$RODEX_ENTRYPOINT")
case "$RODEX_INTERPRETER" in
    /*) ;;
    *)
        printf 'rodex: sealed project entrypoint has no absolute interpreter\n' >&2
        exit 1
        ;;
esac
RODEX_INTERPRETER=$(/usr/bin/readlink -f -- "$RODEX_INTERPRETER")
interpreter_owner_uid=$(/usr/bin/stat -Lc '%u' -- "$RODEX_INTERPRETER")
if [ "$interpreter_owner_uid" != "$current_uid" ] && \
        [ "$interpreter_owner_uid" != 0 ]; then
    printf 'rodex: refusing interpreter owned by untrusted uid %s: %s\n' \
        "$interpreter_owner_uid" "$RODEX_INTERPRETER" >&2
    exit 1
fi
insecure_interpreter=$(
    /usr/bin/find "$RODEX_INTERPRETER" -maxdepth 0 \
        \( ! -type f -o -perm /022 \) -print -quit
)
if [ -n "$insecure_interpreter" ]; then
    printf 'rodex: refusing nonregular or group/world-writable interpreter: %s\n' \
        "$RODEX_INTERPRETER" >&2
    exit 1
fi

unset PYTHONHOME PYTHONPATH PYTHONSTARTUP
exec "$RODEX_ENTRYPOINT" "$@"
